# Westminster Wanderers Pellet Index
#
# Copy to `.env.local` on a laptop (never commit `.env.local`).
# Preferred once Vercel exists:
#   vercel env pull .env.local --environment=development --yes
# Development is scoped to the staging database — see environments.md.
# Never pull --environment=production into `.env.local`.
#
# Connection rules: docs/02-architecture/connections.md
# Environments:     docs/02-architecture/environments.md
# Engineering:      docs/02-architecture/engineering-guide.md
#
# Which world this process thinks it is in.
# local       — laptop / agent VM (.env.local only)
# staging     — Vercel Development, Preview, custom env `staging`
# production  — Vercel Production only. Never put this in .env.local.
WW_ENV=local

# Shared pooler TRANSACTION mode (port 6543, IPv4). Next.js runtime only.
# User is postgres.<PROJECT_REF> — copy from dashboard Connect, do not invent.
# Direct db.<ref>.supabase.co will fail from Vercel (IPv6).
# Local and staging: STAGING project. Production target: PROD project.
DATABASE_URL=

# Shared pooler SESSION mode (port 5432, IPv4). drizzle-kit / migrations / psql.
DATABASE_URL_SESSION=

# Optional. If empty, the app is public to read.
# Staging and production should not share a passphrase if this is set.
VIEWER_PASSPHRASE=

# Required for every write. Staging test secret ≠ live production secret.
ADMIN_PASSPHRASE=

# HMAC key for session cookies. Long random string.
# Staging and production MUST be different values.
SESSION_SECRET=

# Never put DATABASE_URL, DATABASE_URL_SESSION, or a service-role key in NEXT_PUBLIC_*.
# Ignore any NEXT_PUBLIC_SUPABASE_* keys Marketplace injects — we do not use supabase-js.
